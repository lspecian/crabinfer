{
  "name": "@crabinfer/node",
  "version": "0.1.0",
  "description": "Node.js binding for CrabInfer — safe, memory-aware LLM inference",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "crabinfer",
    "triples": {
      "defaults": false,
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lspecian/crabinfer"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "optionalDependencies": {
    "@crabinfer/node-darwin-arm64": "0.1.0",
    "@crabinfer/node-darwin-x64": "0.1.0",
    "@crabinfer/node-linux-x64-gnu": "0.1.0",
    "@crabinfer/node-linux-arm64-gnu": "0.1.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --features metal,providers",
    "build:debug": "napi build --platform --features metal,providers",
    "build:cpu": "napi build --platform --release --features cpu-only,providers",
    "prepublishOnly": "napi prepublish -t npm",
    "universal": "napi universal"
  },
  "engines": {
    "node": ">= 18"
  }
}
